@echo off
setlocal EnableExtensions
title QuantGuard - installation
set "SELF=%~f0"
set "DEST=%USERPROFILE%\QuantGuard"
echo.
echo  ===============================================
echo   QuantGuard - installation automatique
echo  ===============================================
echo.
echo  Dossier d'installation : %DEST%
echo  Extraction des fichiers, patientez...
echo.
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; try { $t=[IO.File]::ReadAllText($env:SELF); $m='::QG'+'ZIP::'; $i=$t.LastIndexOf($m); if($i -lt 0){throw 'contenu introuvable'}; $b=($t.Substring($i+$m.Length)) -replace '[^A-Za-z0-9+/=]',''; $z=Join-Path $env:TEMP 'quantguard-install.zip'; [IO.File]::WriteAllBytes($z,[Convert]::FromBase64String($b)); New-Item -ItemType Directory -Force -Path $env:DEST | Out-Null; Expand-Archive -LiteralPath $z -DestinationPath $env:DEST -Force; Remove-Item $z -Force; exit 0 } catch { Write-Host ('  [ERREUR] ' + $_.Exception.Message); exit 1 }"
if errorlevel 1 goto :echec
if not exist "%DEST%\quantguard\start.bat" goto :echec
echo  Fichiers installes dans %DEST%\quantguard
echo  Pour relancer plus tard : double-clic sur start.bat dans ce dossier.
echo.
start "" explorer "%DEST%\quantguard"
call "%DEST%\quantguard\start.bat"
exit /b 0

:echec
echo.
echo  [ERREUR] L'extraction a echoue. Copiez le message ci-dessus et envoyez-le.
echo.
pause
exit /b 1

